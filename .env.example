# @BotFather 给的完整 token，形如 123456789:AAH...
TG_BOT_TOKEN=

# my.telegram.org/apps 的 api_id / api_hash
# 用 MTProto 上传大文件（>50 MiB）需要，机器人本身也必须用 MTProto 登录
TG_API_ID=
TG_API_HASH=

# Telethon session 文件名（登录后生成 tg-sync-bot.session）
TG_SESSION=tg-sync-bot

# 下载临时目录 / 去重状态文件
TG_DOWNLOAD_DIR=downloads
TG_TASK_DB=state/tasks.db

# 允许使用机器人的 user id，逗号/空格分隔。
# 留空时机器人会拒绝所有人，并回复「你的 user id 是 xxx」——先发 /start 拿到 id 再填这里。
TG_ALLOWED_USERS=

# 结果发到哪里：留空 = 回复命令所在聊天；
# 也可以填 -1001234567890（频道/群 id）或 @channelusername
TG_TARGET_CHAT=

# 上传上限（MiB）。机器人上限 2000
TG_MAX_FILE_SIZE_MB=2048

# 是否显示进度消息（成功后自动删除）
TG_STATUS_MESSAGES=true

# 下载后保留本地文件
TG_KEEP_FILES=false

# 单个任务超时（秒），0 = 不限。网络抖动时避免队列被卡死
TG_JOB_TIMEOUT=3600

# 并发 worker 数（1-8）
TG_WORKERS=3

# 收到 SIGTERM/SIGINT 后等待进行中任务完成的秒数
TG_SHUTDOWN_GRACE=300

# 代理，例如 socks5://127.0.0.1:1080 或 http://127.0.0.1:7890
# socks 代理需要额外安装：pip install "tg-sync[socks]"
TG_PROXY=

# X 经常要求登录才能读取媒体：导出 Netscape 格式 cookies 文件
TG_YTDLP_COOKIES=
# 或者直接从浏览器读取 cookies：chrome / firefox / edge / safari
TG_YTDLP_COOKIES_FROM_BROWSER=

TG_LOG_LEVEL=INFO
